# ===== Secrets locaux (modele : copier en application-secret.properties) =====
# Ce fichier est ignore par git. Il est charge par application.properties
# via spring.config.import=optional:classpath:application-secret.properties
# Les variables d'environnement du meme nom restent prioritaires.

DB_URL=jdbc:postgresql://localhost:5432/tantana
DB_USERNAME=postgres
DB_PASSWORD=
